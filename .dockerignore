# The build context is sent to the daemon in full before anything runs, so this
# file is the difference between a build that starts in a second and one that
# spends a minute uploading a node_modules tree it is about to rebuild anyway.

node_modules
**/node_modules

# Build output — the image builds its own. Copying a host build in would also
# carry native modules compiled for the host's platform, which fail at runtime
# in a way that points nowhere near the cause.
**/dist
**/.next
**/.next-deploy
**/*.tsbuildinfo

.git
.github

# Secrets never enter the image. They arrive at runtime through env_file, so a
# published image cannot carry a master key that decrypts exchange credentials.
.env
.env.*
!.env.example

# Local state
*.db
*.db-wal
*.db-shm
.DS_Store
coverage
