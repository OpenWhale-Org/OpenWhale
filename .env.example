# OpenWhale environment — loaded by the GATEWAY (real env > packages/gateway/.env > this repo-root .env).
# The dashboard is a pure frontend and holds NO secrets; it only optionally reads:
#   OPENWHALE_GATEWAY_URL   where to reach the gateway (default http://localhost:3001)

# REQUIRED — encrypts stored credentials (venue private keys) at rest. Use a strong secret.
OPENWHALE_MASTER_KEY=

# REQUIRED on first boot — creates the first dashboard account, then the gateway
# refuses to start until one exists. Remove both once you have signed in.
OPENWHALE_ADMIN_USER=
OPENWHALE_ADMIN_PASSWORD=

# Optional — browser origins allowed to call the gateway directly (comma-separated).
# The dashboard proxies /api/* same-origin and needs none of this; set it when a
# custom frontend or a browser EventSource talks to :3001 across origins.
#OPENWHALE_ALLOWED_ORIGIN=http://localhost:3000

# Optional — SQLite path (default ~/.openwhale/openwhale.db)
#OPENWHALE_DB_PATH=

# Optional — gateway listen port (default 3001)
#OPENWHALE_GATEWAY_PORT=3001

# Optional — LLM provider keys, imported as typed credentials on boot
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
