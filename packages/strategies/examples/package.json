{
  "name": "@openwhaleorg/examples",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWhale-Org/OpenWhale",
    "directory": "packages/strategies/examples"
  },
  "homepage": "https://github.com/OpenWhale-Org/OpenWhale#readme",
  "bugs": {
    "url": "https://github.com/OpenWhale-Org/OpenWhale/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "run:copy-trading": "npx tsx runnable/copy-trading.ts"
  },
  "dependencies": {
    "zod": "^4.4.1",
    "@openwhaleorg/exchange": "workspace:*"
  },
  "peerDependencies": {
    "@openwhaleorg/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^1.6.0",
    "tsx": "^4.19.2",
    "@openwhaleorg/hyperliquid": "workspace:*"
  }
}
