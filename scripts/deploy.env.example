# Copy to scripts/deploy.env and fill in. That file is gitignored — it names
# your host and your key.

# Required. Where to deploy.
DEPLOY_HOST=user@example.com

# Path on the server, relative to the login user's home.
DEPLOY_PATH=openwhale

# Optional: an SSH key, when it is not the one your agent already offers.
DEPLOY_SSH_KEY=

# Optional: the public URL, for the post-deploy health check. Without it the
# script only verifies that the services came back up.
DEPLOY_URL=https://openwhale.example.com

# Optional: local plugin packages to build and sync alongside the repo.
# Each entry is a directory, optionally `:remote_parent` when that plugin does
# not live under DEPLOY_REMOTE_PLUGINS on the server.
#
#   DEPLOY_PLUGINS="$HOME/code/my-strategy $HOME/code/venue-x:custom/venues"
DEPLOY_PLUGINS=
DEPLOY_REMOTE_PLUGINS=plugins

# systemd units to restart.
DEPLOY_SERVICES="openwhale-gateway openwhale-dashboard"

# Optional: refuse to deploy during these minutes past the hour, UTC, as
# FROM-TO. Restarting the gateway interrupts whatever is mid-execution, so if
# your strategies work in cycles around a fixed instant, name that window here.
# Wraps: 54-01 means :54 through :01. Empty disables the check.
DEPLOY_BLACKOUT=
